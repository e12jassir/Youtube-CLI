# yt configuration — ~/.config/yt/config
# Plain KEY=value lines. Nothing here is executed. Environment variables win.

# ── content ──────────────────────────────────────────────
YT_FEED_SIZE=100            # items fetched for "for you" / subscriptions
YT_SEARCH_SIZE=40           # results per search
YT_HIDE_SHORTS=1            # 1 = hide Shorts
YT_INTERLEAVE=1             # 1 = mix channels in "for you" so none floods the list
YT_HOME=auto                # auto | foryou | subs | later | history | search

# ── speed ────────────────────────────────────────────────
YT_CACHE_TTL=900            # seconds a feed is considered fresh (stale data still shows instantly)
YT_COOKIE_TTL=21600         # seconds between reads of your browser's cookie database
YT_PREFETCH=24              # thumbnails pre-downloaded in parallel (0 = off)
YT_THUMB_QUALITY=mq         # mq (fast, 16:9) | hq | max

# ── playback ─────────────────────────────────────────────
YT_DEFAULT_MODE=window      # window | pip | fs
YT_QUALITY=1080             # max video height (0 = no limit)
YT_PLAYBACK=pipe            # pipe (instant & reliable, bypasses 403 hang) | direct | auto

# ── login (cookies) ──────────────────────────────────────
YT_COOKIES=auto             # auto | off (guest: search only)
YT_BROWSERS="zen firefox librewolf brave chromium chrome"   # detection order
# YT_BROWSER=firefox:/path/to/profile    # force one source (any yt-dlp --cookies-from-browser spec)
# YT_COOKIES_FILE=~/cookies.txt          # or use an exported Netscape cookies file

# ── interface ────────────────────────────────────────────
YT_LANG=auto                # auto | es | en
YT_PREVIEW=auto             # auto | kitty | chafa | none
YT_HEIGHT=95%
YT_NOTIFY=1
# YT_BROWSER_CMD=firefox    # ^o opens this (default: $BROWSER, xdg-open or open)
# YT_DOWNLOAD_DIR=~/Videos
# YT_YTDLP_ARGS="--js-runtimes deno"   # extra yt-dlp flags
# YT_FZF_OPTS=""
