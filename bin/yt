#!/usr/bin/env bash
# yt - Minimalist, high-performance terminal YouTube client
# Supports Kitty ICAT GPU previews, multi-browser cookies & graceful guest fallback.

set -e

VERSION="1.1.0"

# --- PATHS ---
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/yt_terminal"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt"
mkdir -p "$CACHE_DIR" "$STATE_DIR"

HISTORY_FILE="$STATE_DIR/history.tsv"
WATCHLATER_FILE="$STATE_DIR/watchlater.tsv"
[ -f "$HISTORY_FILE" ]    || touch "$HISTORY_FILE"
[ -f "$WATCHLATER_FILE" ] || touch "$WATCHLATER_FILE"

# --- CONFIG FILE ---
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/yt/config"
# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

# Defaults (override via ~/.config/yt/config)
: "${YT_FEED_SIZE:=100}"
: "${YT_SEARCH_SIZE:=40}"
: "${YT_CACHE_TTL:=900}"
: "${YT_AUDIO_VOLUME:=75}"
: "${YT_DEFAULT_MODE:=window}"
: "${YT_BROWSER_CMD:=${BROWSER:-zen}}"

# --- SPINNER & CURSOR CONTROL ---
_spinner_pid=""

spinner_start() {
    local msg="$1"
    # Ocultar cursor y silenciar entrada de teclado para evitar artefactos
    printf "\033[?25l" >&2
    stty -echo 2>/dev/null || true

    ( local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
      local i=0
      while true; do
          if [ -n "$msg" ]; then
              printf "\r\033[90m%s %s\033[0m" "${frames[$((i % 10))]}" "$msg" >&2
          else
              printf "\r\033[31m%s\033[0m" "${frames[$((i % 10))]}" >&2
          fi
          sleep 0.08
          i=$(( i + 1 ))
      done ) &
    _spinner_pid=$!
}

spinner_stop() {
    if [ -n "$_spinner_pid" ]; then
        kill "$_spinner_pid" 2>/dev/null
        wait "$_spinner_pid" 2>/dev/null
        _spinner_pid=""
    fi
    printf "\r\033[2K\033[?25h" >&2
    stty echo 2>/dev/null || true
}

# --- CLEANUP & SIGNAL HANDLING ---
_cleanup() {
    spinner_stop
    printf "\033[?25h" >&2
    stty echo 2>/dev/null || true
    kitty +kitten icat --clear --silent 2>/dev/null || true
}
trap '_cleanup' EXIT INT TERM

# --- BROWSER / COOKIE DETECTION ---
detect_browser_cookies() {
    if [ -n "$YT_BROWSER" ]; then
        COOKIE_ARG=(--cookies-from-browser "$YT_BROWSER")
        COOKIE_STATUS="custom ($YT_BROWSER)"
        return 0
    fi

    local zen_prof
    zen_prof=$(find "${XDG_CONFIG_HOME:-$HOME/.config}/zen" -maxdepth 1 -name "*.Default*" -print -quit 2>/dev/null || true)
    if [ -n "$zen_prof" ] && [ -f "$zen_prof/cookies.sqlite" ]; then
        COOKIE_ARG=(--cookies-from-browser "firefox:$zen_prof")
        COOKIE_STATUS="zen"
        return 0
    fi

    local ff_prof
    ff_prof=$(find "${XDG_CONFIG_HOME:-$HOME/.mozilla/firefox}" -maxdepth 1 \( -name "*.default-release*" -o -name "*.default*" \) -print -quit 2>/dev/null || true)
    if [ -n "$ff_prof" ] && [ -f "$ff_prof/cookies.sqlite" ]; then
        COOKIE_ARG=(--cookies-from-browser "firefox:$ff_prof")
        COOKIE_STATUS="firefox"
        return 0
    fi

    local lw_prof
    lw_prof=$(find "${XDG_CONFIG_HOME:-$HOME/.librewolf}" -maxdepth 1 \( -name "*.default-release*" -o -name "*.default*" \) -print -quit 2>/dev/null || true)
    if [ -n "$lw_prof" ] && [ -f "$lw_prof/cookies.sqlite" ]; then
        COOKIE_ARG=(--cookies-from-browser "firefox:$lw_prof")
        COOKIE_STATUS="librewolf"
        return 0
    fi

    for br in brave-browser brave chromium google-chrome-stable google-chrome; do
        if command -v "$br" >/dev/null 2>&1; then
            COOKIE_ARG=(--cookies-from-browser "$br")
            COOKIE_STATUS="$br"
            return 0
        fi
    done

    COOKIE_ARG=()
    COOKIE_STATUS="guest"
    return 1
}

COOKIE_ARG=()
COOKIE_STATUS="guest"
detect_browser_cookies || true

# --- FZF VISUAL THEME ---
FZF_OPTS=(
    --color "bg:-1,bg+:-1,gutter:-1,border:238,header:241,info:241,prompt:1,pointer:1,marker:2,hl:4,hl+:4,spinner:1,label:238,query:-1,fg:-1,fg+:15"
    --pointer "▌"
    --marker "●"
    --scrollbar "│"
)

# --- UTILITIES ---
is_cache_valid() {
    local file="$1"
    local ttl="${2:-$YT_CACHE_TTL}"
    if [ -s "$file" ]; then
        local age=$(( $(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
        [ "$age" -lt "$ttl" ] && return 0
    fi
    return 1
}

cache_age_human() {
    local file="$1"
    [ -s "$file" ] || { printf "sin cache"; return; }
    local age=$(( $(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
    if   [ "$age" -lt 60 ];   then printf "ahora"
    elif [ "$age" -lt 3600 ]; then printf "%dm" $(( age / 60 ))
    else                           printf "%dh" $(( age / 3600 ))
    fi
}

# --- CHANNEL INTERLEAVING ---
interleave_by_channel() {
    python3 -c "
import sys
from collections import defaultdict

lines = [line.strip().split('\t') for line in sys.stdin if line.strip()]
by_channel = defaultdict(list)
channels_order = []

for item in lines:
    if len(item) < 5:
        continue
    channel = item[1]
    if channel not in by_channel:
        channels_order.append(channel)
    by_channel[channel].append(item)

if not by_channel:
    sys.exit(0)

max_len = max(len(v) for v in by_channel.values())
interleaved = []
for i in range(max_len):
    for ch in channels_order:
        if i < len(by_channel[ch]):
            interleaved.append(by_channel[ch][i])

for item in interleaved:
    print('\t'.join(item))
"
}

format_feed_items() {
    local raw_data="$1"
    local formatted=""

    while IFS=$'\t' read -r title uploader duration id url; do
        [ -z "$id" ] && continue
        [ -z "$duration" ] || [ "$duration" = "NA" ] && duration="live"

        local clean_title clean_uploader
        clean_title="${title//$'\r'/}"
        clean_title="${clean_title//$'\n'/}"
        clean_uploader="${uploader//$'\r'/}"
        clean_uploader="${clean_uploader//$'\n'/}"

        local display_str
        printf -v display_str "  \033[90m%-7s\033[0m  %-58.58s  \033[90m%s\033[0m" \
            "$duration" "$clean_title" "$clean_uploader"
        formatted+="${display_str}"$'\t'"${clean_title}"$'\t'"${clean_uploader}"$'\t'"${duration}"$'\t'"${id}"$'\t'"${url}"$'\n'
    done <<< "$raw_data"

    printf "%s" "$formatted"
}

# --- FEED FETCHING ---
fetch_feed() {
    local feed_url="$1"
    local cache_file="$2"
    local force_refresh="$3"
    local interleave="$4"

    if [ "$force_refresh" != "true" ] && is_cache_valid "$cache_file"; then
        cat "$cache_file"
        return 0
    fi

    spinner_start "sincronizando..."

    local raw_data
    raw_data=$(yt-dlp "${COOKIE_ARG[@]}" --flat-playlist \
        --print "%(title)s"$'\t'"%(uploader)s"$'\t'"%(duration_string)s"$'\t'"%(id)s"$'\t'"%(url)s" \
        --playlist-items "1:$YT_FEED_SIZE" "$feed_url" 2>/dev/null || true)

    spinner_stop

    if [ -z "$raw_data" ]; then
        [ -s "$cache_file" ] && cat "$cache_file"
        return 0
    fi

    if [ "$interleave" = "true" ]; then
        raw_data=$(printf "%s\n" "$raw_data" | interleave_by_channel)
    fi

    local formatted
    formatted=$(format_feed_items "$raw_data")

    printf "%s" "$formatted" > "$cache_file"
    printf "%s" "$formatted"
}

search_feed() {
    local query="$1"

    spinner_start "buscando: $query..."

    local raw_data
    raw_data=$(yt-dlp "${COOKIE_ARG[@]}" --flat-playlist \
        --print "%(title)s"$'\t'"%(uploader)s"$'\t'"%(duration_string)s"$'\t'"%(id)s"$'\t'"%(url)s" \
        --playlist-items "1:$YT_SEARCH_SIZE" "ytsearch${YT_SEARCH_SIZE}:$query" 2>/dev/null || true)

    spinner_stop

    format_feed_items "$raw_data"
}

# --- HISTORY ---
record_history() {
    # Almacenar formato TSV limpio sin códigos ANSI: id \t title \t uploader \t duration \t url \t timestamp
    local title="$1" uploader="$2" duration="$3" id="$4" url="$5"
    [ -z "$id" ] && return 0
    local ts
    ts=$(date +%s)
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$id" "$title" "$uploader" "$duration" "$url" "$ts" >> "$HISTORY_FILE"
}

# --- VIDEO PLAYBACK ---
play_video() {
    local mode="$1" # "window", "pip", "fs"
    local title="$2" uploader="$3" duration="$4" id="$5" url="$6"

    record_history "$title" "$uploader" "$duration" "$id" "$url"
    spinner_start ""

    local ipc_sock="/tmp/yt_mpv_$$.sock"
    rm -f "$ipc_sock"

    local mpv_opts=(
        --hwdec=auto
        --no-terminal
        --really-quiet
        --force-media-title="$title"
        --input-ipc-server="$ipc_sock"
    )

    case "$mode" in
        "pip")
            mpv_opts+=(--no-fs --ontop --title="Picture-in-Picture" --geometry=30%x30%-20-20 --autofit=28%)
            ;;
        "fs")
            mpv_opts+=(--fs --title="$title")
            ;;
        *) # window
            mpv_opts+=(--no-fs --autofit=65%x65% --title="$title")
            ;;
    esac

    # Stream video via yt-dlp pipe directly to mpv stdin to bypass YouTube 403 Forbidden & bot checks
    (
        yt-dlp "${COOKIE_ARG[@]}" \
            -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]/best" \
            --remux-video mkv -o - "$url" 2>/dev/null \
            | mpv "${mpv_opts[@]}" -
    ) >/dev/null 2>&1 &
    local pipeline_pid=$!
    disown "$pipeline_pid" 2>/dev/null || true

    # Esperar a que la ventana de video y el renderizador estén efectivamente en pantalla
    python3 -c "
import socket, json, time, sys, os

sock_path = '$ipc_sock'
pid = $pipeline_pid

start_time = time.time()
connected = False
s = None

# 1. Esperar que mpv levante el socket IPC
while time.time() - start_time < 20:
    try:
        os.kill(pid, 0)
    except OSError:
        sys.exit(0)

    if os.path.exists(sock_path):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock_path)
            s.settimeout(0.5)
            connected = True
            break
        except Exception:
            pass
    time.sleep(0.05)

# 2. Polling activo de la ventana y frames de video
if connected and s:
    buf = ''
    while time.time() - start_time < 30:
        try:
            os.kill(pid, 0)
        except OSError:
            break

        try:
            cmd = json.dumps({'command': ['get_property', 'vo-configured']}) + '\n'
            s.sendall(cmd.encode())
            chunk = s.recv(2048).decode()
            buf += chunk
            while '\n' in buf:
                line, buf = buf.split('\n', 1)
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                    if msg.get('data') is True or msg.get('event') == 'video-reconfig' or msg.get('event') == 'playback-restart':
                        s.close()
                        sys.exit(0)
                except Exception:
                    pass
        except Exception:
            pass
        time.sleep(0.06)

    try:
        s.close()
    except Exception:
        pass
" 2>/dev/null || true

    spinner_stop
    rm -f "$ipc_sock"
    notify-send --app-name="yt" --urgency=low "yt" "▶ $title" 2>/dev/null || true
    return 0
}

# --- BROWSE ITEMS ---
browse_items() {
    local feed_data="$1"
    local prompt_title="$2"

    if [ -z "$feed_data" ]; then
        printf "\033[90m· no se encontraron resultados.\033[0m\n"
        sleep 1.2
        return 1
    fi

    local fzf_out
    fzf_out=$(printf "%s" "$feed_data" | fzf "${FZF_OPTS[@]}" --ansi \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt="  › " \
        --ghost="filtrar..." \
        --header=$'enter: reproducir (ventana)  ·  ctrl-p: mini picture  ·  ctrl-f: pantalla completa  ·  ctrl-a: audio  ·  ctrl-y: copiar  ·  ctrl-w: ver después  ·  ctrl-d: descargar  ·  ctrl-o: navegador  ·  ctrl-r: recargar' \
        --preview='yt-thumb-preview {5} {2} {3} {4}' \
        --preview-window=right:48%:border-left:wrap \
        --expect=ctrl-a,ctrl-y,ctrl-d,ctrl-o,ctrl-r,ctrl-w,ctrl-p,ctrl-f \
        --height=95% \
        --layout=reverse \
        --border=rounded \
        --border-label=" $prompt_title " \
        --border-label-pos=2 \
        --info=inline)

    kitty +kitten icat --clear --silent 2>/dev/null || true
    [ -z "$fzf_out" ] && return 0

    local key
    key=$(printf "%s\n" "$fzf_out" | head -n 1)
    local selection
    selection=$(printf "%s\n" "$fzf_out" | tail -n +2)
    [ -z "$selection" ] && return 0

    IFS=$'\t' read -r display title uploader duration id url <<< "$selection"

    case "$key" in
        "ctrl-r")
            return 2
            ;;
        "ctrl-a")
            notify-send --app-name="yt" --urgency=low "yt" "🎧 $title" 2>/dev/null || true
            (
                yt-dlp "${COOKIE_ARG[@]}" -f "bestaudio/best" -o - "$url" 2>/dev/null \
                    | mpv --no-video --volume="$YT_AUDIO_VOLUME" --really-quiet --no-terminal -
            ) >/dev/null 2>&1 &
            return 0
            ;;
        "ctrl-y")
            local share_url="https://youtu.be/$id"
            if command -v wl-copy >/dev/null 2>&1; then
                printf "%s" "$share_url" | wl-copy
            elif command -v xclip >/dev/null 2>&1; then
                printf "%s" "$share_url" | xclip -selection clipboard
            fi
            notify-send --app-name="yt" --urgency=low "yt" "📋 $share_url" 2>/dev/null || true
            return 0
            ;;
        "ctrl-w")
            if grep -qF "$id" "$WATCHLATER_FILE" 2>/dev/null; then
                grep -vF "$id" "$WATCHLATER_FILE" > "${WATCHLATER_FILE}.tmp" \
                    && mv "${WATCHLATER_FILE}.tmp" "$WATCHLATER_FILE"
                notify-send --app-name="yt" --urgency=low "yt" "✗ Ver después: eliminado" 2>/dev/null || true
            else
                printf "%s\n" "$selection" >> "$WATCHLATER_FILE"
                notify-send --app-name="yt" --urgency=low "yt" "✓ Ver después: $title" 2>/dev/null || true
            fi
            return 0
            ;;
        "ctrl-d")
            local dest_dir="${XDG_VIDEOS_DIR:-$HOME/Videos}"
            mkdir -p "$dest_dir"
            notify-send --app-name="yt" --urgency=low "yt" "📥 Descargando: $title" 2>/dev/null || true
            nohup env _YT_URL="$url" _YT_DEST="$dest_dir" _YT_TITLE="$title" \
                bash -c 'yt-dlp -o "$_YT_DEST/%(title)s.%(ext)s" "$_YT_URL" \
                    && notify-send --app-name="yt" "yt" "✅ $_YT_TITLE"' \
                >/dev/null 2>&1 &
            return 0
            ;;
        "ctrl-o")
            local browser_cmd="${YT_BROWSER_CMD:-xdg-open}"
            command -v "$browser_cmd" >/dev/null 2>&1 || browser_cmd="xdg-open"
            nohup "$browser_cmd" "$url" >/dev/null 2>&1 &
            return 0
            ;;
        "ctrl-p")
            play_video "pip" "$title" "$uploader" "$duration" "$id" "$url"
            return 0
            ;;
        "ctrl-f")
            play_video "fs" "$title" "$uploader" "$duration" "$id" "$url"
            return 0
            ;;
        "")
            play_video "${YT_DEFAULT_MODE:-window}" "$title" "$uploader" "$duration" "$id" "$url"
            return 0
            ;;
    esac
}

browse_feed() {
    local feed_url="$1"
    local cache_file="$2"
    local prompt_title="$3"
    local interleave="${4:-false}"
    local force_refresh="false"

    while :; do
        local feed_data
        feed_data=$(fetch_feed "$feed_url" "$cache_file" "$force_refresh" "$interleave")
        force_refresh="false"

        local status=0
        browse_items "$feed_data" "$prompt_title" || status=$?

        if [ "$status" -eq 2 ]; then
            rm -f "$cache_file"
            force_refresh="true"
            continue
        fi
        # Volver al menú principal
        return 0
    done
}

run_search() {
    local query="$1"
    if [ -z "$query" ]; then
        read -rp "buscar › " query
    fi
    [ -z "$query" ] && return 0

    local search_data
    search_data=$(search_feed "$query")
    local status=0
    browse_items "$search_data" "búsqueda: $query" || status=$?
    return 0
}

browse_history() {
    if [ ! -s "$HISTORY_FILE" ]; then
        printf "\033[90m· el historial está vacío.\033[0m\n"
        sleep 1.2
        return 0
    fi

    # Deduplicar preservando el orden más reciente
    local raw_hist
    raw_hist=$(tac "$HISTORY_FILE" | awk -F'\t' '
        NF >= 5 {
            # Si es formato nuevo: id \t title \t uploader \t duration \t url \t ts
            id = $1
            if (!seen[id]++) {
                print $2 "\t" $3 "\t" $4 "\t" $1 "\t" $5
            }
        }
    ')

    if [ -z "$raw_hist" ]; then
        # Fallback para líneas en formato previo si existían
        raw_hist=$(tac "$HISTORY_FILE" | awk -F'\t' 'NF>=5 && !seen[$5]++ { print $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 }')
    fi

    local hist_data
    hist_data=$(format_feed_items "$raw_hist")
    local status=0
    browse_items "$hist_data" "historial" || status=$?
    return 0
}

browse_watchlater() {
    if [ ! -s "$WATCHLATER_FILE" ]; then
        printf "\033[90m· ver después está vacío.\033[0m\n"
        sleep 1.2
        return 0
    fi

    local wl_data
    wl_data=$(cat "$WATCHLATER_FILE")
    [ -z "$wl_data" ] && return 0
    local status=0
    browse_items "$wl_data" "ver después" || status=$?
    return 0
}

# --- MENU ---
build_menu_options() {
    if [ "$COOKIE_STATUS" != "guest" ]; then
        printf "· para ti\n· suscripciones\n"
    else
        printf "· tendencias\n"
    fi
    printf "· ver después\n· historial\n· salir\n"
}

main() {
    if [ "$#" -gt 0 ]; then
        run_search "$*"
        return 0
    fi

    while :; do
        local fzf_out
        fzf_out=$(build_menu_options | fzf "${FZF_OPTS[@]}" \
            --disabled \
            --print-query \
            --prompt="  › " \
            --ghost="buscar en youtube..." \
            --bind="esc:cancel" \
            --height=35% \
            --layout=reverse \
            --border=rounded \
            --border-label=" yt " \
            --border-label-pos=2 \
            --info=hidden)

        local status=$?
        [ $status -ne 0 ] && return 0

        local query item
        query=$(printf "%s\n" "$fzf_out" | sed -n '1p')
        item=$(printf "%s\n" "$fzf_out" | sed -n '2p')

        if [ -n "$query" ]; then
            run_search "$query"
        else
            [ -z "$item" ] && return 0
            case "$item" in
                "· para ti"*)
                    browse_feed "https://www.youtube.com/" \
                        "$CACHE_DIR/feed_para_ti.tsv" "para ti" "true"
                    ;;
                "· tendencias"*)
                    browse_feed "https://www.youtube.com/feed/trending" \
                        "$CACHE_DIR/feed_tendencias.tsv" "tendencias" "false"
                    ;;
                "· suscripciones"*)
                    browse_feed "https://www.youtube.com/feed/subscriptions" \
                        "$CACHE_DIR/feed_suscripciones.tsv" "suscripciones" "false"
                    ;;
                "· ver después"*)
                    browse_watchlater
                    ;;
                "· historial"*)
                    browse_history
                    ;;
                "· salir"*)
                    exit 0
                    ;;
                *)
                    run_search "$item"
                    ;;
            esac
        fi
    done
}

main "$@"
